# Neon connection string (use the pooled one)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
# Your Netlify site URL(s), comma separated, NO trailing slash
# e.g. https://your-site.netlify.app,https://rsvp.yourdomain.com
CORS_ORIGINS=https://your-site.netlify.app,http://localhost,http://127.0.0.1,http://localhost:8080
# Used only by `npm run setup` to create the first admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-strong-password
PORT=5000
